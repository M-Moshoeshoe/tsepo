# Copy this file to .env.local and fill in the values there.
# Never put a real seed in this file. .env.local is gitignored.

# XRP Ledger Testnet only.
XRPL_NETWORK_URL=wss://s.altnet.rippletest.net:51233

# RLUSD issuer on Testnet.
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# Default SourceTag for agent payments.
AGENT_SOURCE_TAG=20260530

# Account seeds. Each stays in .env.local only.
ISSUER_SEED=replace-with-issuer-seed
BUSINESS_SEED=replace-with-business-seed
AGENT_SEED=replace-with-agent-seed
POLICY_SEED=replace-with-policy-seed
EXCHANGE_SEED=replace-with-exchange-agent-lane-seed
CONTRACTOR_SEED=replace-with-contractor-seed
