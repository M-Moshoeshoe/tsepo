# Local settings. npm run spike:accounts creates .env.local and fills in
# every seed for you. Never put a real seed in this file. .env.local is
# gitignored and is the only place seeds are kept.
#
# The network (XRPL Testnet) and the RLUSD issuer are fixed in
# src/ledger/testnet.ts and are not settings.

# SourceTag for agent payments. Optional; the default is 20260530.
AGENT_SOURCE_TAG=20260530

# Account seeds.
ISSUER_SEED=replace-with-issuer-seed
BUSINESS_SEED=replace-with-business-seed
AGENT_SEED=replace-with-agent-seed
POLICY_SEED=replace-with-policy-seed
EXCHANGE_SEED=replace-with-exchange-agent-lane-seed
CONTRACTOR_SEED=replace-with-contractor-seed
UNKNOWN_AGENT_SEED=replace-with-unknown-agent-seed

# The agent's signing key for multisig. It is a key, not a funded account:
# a signer list cannot name the account it belongs to.
AGENT_SIGNER_SEED=replace-with-agent-signing-key-seed

# Anthropic API key for the payout agent (Claude). Optional for the
# spikes; required for scenarios 2, 3 and 4.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Access code for starting demo runs from the interface (at least 6
# characters). Without it the run endpoint refuses every request.
DEMO_ACCESS_CODE=replace-with-a-short-demo-code
