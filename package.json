{
  "name": "tsepo",
  "version": "0.1.0",
  "description": "Identity and authority for AI agents that pay on the XRP Ledger.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "spike:accounts": "node --env-file-if-exists=.env.local spikes/accounts.ts",
    "spike:rlusd": "node --env-file-if-exists=.env.local spikes/rlusd.ts",
    "spike:credential": "node --env-file-if-exists=.env.local spikes/credential.ts",
    "spike:agent-lane": "node --env-file-if-exists=.env.local spikes/agent-lane.ts",
    "spike:multisig": "node --env-file-if-exists=.env.local spikes/multisig.ts",
    "spike:revoke": "node --env-file-if-exists=.env.local spikes/revoke.ts",
    "spike:recovery-key": "node --env-file-if-exists=.env.local spikes/recovery-key.ts",
    "scenario:1": "node --env-file-if-exists=.env.local scenarios/run.ts scenario-1",
    "scenario:2": "node --env-file-if-exists=.env.local scenarios/run.ts scenario-2",
    "scenario:3": "node --env-file-if-exists=.env.local scenarios/run.ts scenario-3",
    "scenario:4": "node --env-file-if-exists=.env.local scenarios/run.ts scenario-4",
    "demo:reset": "node --env-file-if-exists=.env.local scenarios/run.ts reset",
    "demo:capture": "node scripts/capture-demo.ts all",
    "demo:screens": "node scripts/capture-demo.ts screens"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ripple-keypairs": "3.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "xrpl": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
