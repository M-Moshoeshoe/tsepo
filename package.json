{
  "name": "tsepo",
  "version": "0.1.0",
  "description": "Identity and authority for AI agents that pay on the XRP Ledger.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "spike:accounts": "node --env-file-if-exists=.env.local spikes/accounts.ts",
    "spike:rlusd": "node --env-file-if-exists=.env.local spikes/rlusd.ts",
    "spike:credential": "node --env-file-if-exists=.env.local spikes/credential.ts",
    "spike:agent-lane": "node --env-file-if-exists=.env.local spikes/agent-lane.ts",
    "spike:multisig": "node --env-file-if-exists=.env.local spikes/multisig.ts",
    "spike:revoke": "node --env-file-if-exists=.env.local spikes/revoke.ts"
  },
  "dependencies": {
    "xrpl": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
